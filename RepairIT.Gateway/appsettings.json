{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "routeOrdinateurs": {
        "ClusterId": "catalogService",
        "Match": { "Path": "/api/ordinateurs/{**catch-all}" }
      },
      "routeUtilisateurs": {
        "ClusterId": "usersService",
        "Match": { "Path": "/api/utilisateurs/{**catch-all}" }
      }
    },
    "Clusters": {
      "catalogService": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5101/" }
        }
      },
      "usersService": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5102/" }
        }
      }
    }
  }
}